{
  "name": "@photostructure/windows-registry",
  "version": "2.0.0",
  "description": "Native node module to access the Windows Registry, with prebuilts",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photostructure/vscode-windows-registry.git"
  },
  "author": "Microsoft Corporation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/photostructure/vscode-windows-registry/issues"
  },
  "homepage": "https://github.com/photostructure/vscode-windows-registry#readme",
  "files": [
    "binding.gyp",
    "dist/",
    "prebuilds/",
    "src/",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "install": "node-gyp-build",
    "clean:dist": "tsx scripts/clean-dist.ts",
    "compile": "npm run clean:dist && tsc -p ./",
    "typecheck": "tsc -p tsconfig.check.json",
    "build:native": "tsx scripts/build-native.ts",
    "analyze:native": "tsx scripts/build-native.ts --analyze",
    "sanitize:native": "tsx scripts/build-native.ts --sanitize",
    "test:sanitize": "tsx scripts/test-native-sanitized.ts",
    "verify:native": "tsx scripts/verify-native-hardening.ts",
    "test:unit": "tsx --test \"test/**/*.test.ts\"",
    "test": "npm run build:native && npm run verify:native && npm run compile && npm run test:unit",
    "audit:prod": "npm audit --omit=dev",
    "check:npm-version": "node scripts/check-npm-version.mjs",
    "update": "npm run check:npm-version && npm-check-updates --upgrade",
    "preflight": "npm run update && npm install && npm run compile && npm run build:native && npm test"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "node-gyp": "13.0.1",
    "npm-check-updates": "23.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
